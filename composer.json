{
    "name": "gemvc/http-client",
    "description": "Multi-Environment PHP HTTP Client Package - Synchronous and Asynchronous API Calls for Apache, Nginx, and Swoole",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "http",
        "client",
        "api",
        "async",
        "synchronous",
        "swoole",
        "apache",
        "nginx",
        "curl",
        "multi-environment"
    ],
    "authors": [
        {
            "name": "Ali Khorsandfard",
            "email": "ali.khorsandfard@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1",
        "phpstan/phpstan": "^2.1",
        "xactsystems/phpstan-extensions": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Gemvc\\Http\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
